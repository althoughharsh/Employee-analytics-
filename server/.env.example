# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/employee-ai-db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/employee-ai-db?retryWrites=true&w=majority

# JWT Configuration (Use a strong random string, min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# OpenRouter API Key (Get from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (Frontend URL)
CORS_ORIGIN=http://localhost:5173
# For production: https://yourdomain.com
